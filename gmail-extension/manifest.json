{
  "manifest_version": 3,
  "name": "H.I.V.E. Email Scanner — Scam Shield",
  "version": "1.0",
  "description": "Auto-scans Gmail emails for UPI scams using H.I.V.E. AI",
  "permissions": ["notifications"],
  "host_permissions": ["http://localhost:8001/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
